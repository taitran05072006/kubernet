apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: ontap-system
  namespace: {{ argocd_namespace }}
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: default
  source:
    repoURL: {{ app_repo_url }}
    targetRevision: HEAD
    path: {{ gitops_manifest_path }}
    helm:
      valueFiles:
        - values.yaml
  destination:
    server: https://kubernetes.default.svc
    namespace: default
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
